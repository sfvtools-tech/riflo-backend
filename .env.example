NODE_ENV=development
FIREBASE_PROJECT_ID=demo-riflo
PORT=4310
# Local emulators only; remove these for a real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional Drive OAuth: set all four together. Use a dedicated web OAuth client.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4311/v1/drive/connection/callback
# DRIVE_TOKEN_ENCRYPTION_KEY=
# Private source storage for video intake. Use only the demo bucket locally.
FIREBASE_STORAGE_BUCKET=demo-riflo.appspot.com
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Required by the worker; install FFmpeg separately and provide its ffprobe binary.
# FFPROBE_PATH=/absolute/path/to/ffprobe
# Optional content generation: set both provider keys and FFMPEG_PATH together.
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# ANTHROPIC_TEXT_MODEL=claude-sonnet-5-5
# Video selection is independent; set explicitly to retain a previous text-model video route.
# ANTHROPIC_VIDEO_MODEL=claude-opus-5-5
# Newsletters are also independent; blogs continue to use ANTHROPIC_TEXT_MODEL.
# Set explicitly to retain a previous text-model newsletter route.
# ANTHROPIC_NEWSLETTER_MODEL=claude-opus-5-5
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi
# GENERATION_MAX_OUTPUT_TOKENS=1200
# GENERATION_STAGE_TIMEOUT_MS=180000
# Optional USD prices in millionths of a dollar, scoped to ANTHROPIC_TEXT_MODEL.
# Exact Sonnet 5.5 / Opus 5.5 IDs have known input/output/cache-read defaults.
# Other model prices and cache-write prices stay unknown unless explicitly supplied.
# ANTHROPIC_INPUT_MICROS_PER_MILLION=
# ANTHROPIC_OUTPUT_MICROS_PER_MILLION=
# ANTHROPIC_CACHE_READ_MICROS_PER_MILLION=
# ANTHROPIC_CACHE_WRITE_MICROS_PER_MILLION=
# Video overrides apply only to ANTHROPIC_VIDEO_MODEL. Writing overrides are reused
# only when the configured model IDs match. Cache-write overrides require known TTL.
# ANTHROPIC_VIDEO_INPUT_MICROS_PER_MILLION=
# ANTHROPIC_VIDEO_OUTPUT_MICROS_PER_MILLION=
# ANTHROPIC_VIDEO_CACHE_READ_MICROS_PER_MILLION=
# ANTHROPIC_VIDEO_CACHE_WRITE_MICROS_PER_MILLION=
# Newsletter overrides apply only to ANTHROPIC_NEWSLETTER_MODEL, with the same
# matching-model inheritance and cache-write TTL requirements as video overrides.
# ANTHROPIC_NEWSLETTER_INPUT_MICROS_PER_MILLION=
# ANTHROPIC_NEWSLETTER_OUTPUT_MICROS_PER_MILLION=
# ANTHROPIC_NEWSLETTER_CACHE_READ_MICROS_PER_MILLION=
# ANTHROPIC_NEWSLETTER_CACHE_WRITE_MICROS_PER_MILLION=
# DEEPGRAM_MICROS_PER_MINUTE=
# Long-form and carousel responses have a separate bounded token allowance.
# GENERATION_LONG_FORM_MAX_OUTPUT_TOKENS=4096

# Optional YouTube imports: use the documented pinned yt-dlp/EJS tools and FFMPEG_PATH.
# YT_DLP_PATH=

# Internal lifecycle verification only. Keep false until retention and abuse release gates pass.
TRIAL_ENABLED=false
# Enroll new lifecycle work only after all readers, workers and cleanup are compatible.
RETENTION_ENABLED=false

# Decoded media policy (independent of plan bytes/duration): permits DCI 4K at 120fps.
# These are admission bounds, not a guarantee of host RAM/CPU capacity.
RIFLO_MEDIA_MAX_DIMENSION=8192
RIFLO_MEDIA_MAX_PIXELS=8847360
RIFLO_MEDIA_MAX_FPS=120
RIFLO_MEDIA_MAX_STREAMS=32

# API process-local capacity. Run one API process per instance; replicas multiply these limits.
# YouTube metadata checks shared by validate/create/retry/restore; worker downloads use worker admission.
SOURCE_VALIDATION_MAX_ACTIVE=4
SOURCE_VALIDATION_MAX_PER_ACCOUNT=1
# Open progress observers (includes ownership checks); excess gets retryable 429 per account / 503 aggregate.
STREAM_MAX_ACTIVE=100
STREAM_MAX_PER_ACCOUNT=5
