{
  "name": "riflo-backend",
  "version": "1.0.0",
  "description": "Riflo backend",
  "scripts": {
    "dev": "concurrently --kill-others --kill-timeout 5000 --names api,worker \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "tsx watch --clear-screen=false --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch --clear-screen=false --env-file=.env src/worker.ts"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "ai": "^7.0.143",
    "firebase-admin": "^14.5.0",
    "sharp": "^0.35.5",
    "twitter-text": "^3.1.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/twitter-text": "^3.1.10",
    "concurrently": "^9.2.5",
    "firebase": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
